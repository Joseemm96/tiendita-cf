{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tiendita-template",
	"compatibility_date": "2026-08-19",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tiendita-db",
			"database_id": "e7a4f3a6-14a4-404b-b108-9c39354e212c",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "PRODUCT_IMAGES",
			"bucket_name": "tiendita-product-images"
		}
	],
	"observability": {
		"enabled": true
	}
}
