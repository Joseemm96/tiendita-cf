---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCloudflareEnv, getStoreSettings } from "@/lib/db";
const { DB } = getCloudflareEnv(Astro.locals);
const settings = await getStoreSettings(DB);
const error = Astro.url.searchParams.get("error");
const next = Astro.url.searchParams.get("next") ?? "/admin";
---

<BaseLayout title="Ingresar" settings={settings} hideChrome>
  <div class="login-page">
    <div class:list={["login-art", { "has-image": settings.loginImageUrl }]} aria-hidden="true">
      {settings.loginImageUrl && <img class="login-art-image" src={settings.loginImageUrl} alt="" />}
    </div>
    <section class="login-panel">
      <a class="wordmark login-brand" href="/" aria-label={`Inicio de ${settings.brandName}`}>
        {settings.logoUrl
          ? <img class="brand-logo brand-logo-login" src={settings.logoUrl} alt={settings.brandName} />
          : <>{settings.brandName}<small>panel de tienda</small></>}
      </a>
      <p class="eyebrow">Acceso privado</p>
      <h1>Bienvenido de vuelta.</h1>
      <p>Gestiona productos, inventario y pedidos desde un solo lugar.</p>
      {error && <p class="login-error">La contraseña no es correcta. Inténtalo de nuevo.</p>}
      <form method="POST" action="/api/admin/login">
        <input type="hidden" name="next" value={next} />
        <div class="field"><label for="password">Contraseña</label><input id="password" name="password" type="password" autocomplete="current-password" required autofocus /></div>
        <button class="button button-block" type="submit">Entrar al dashboard</button>
      </form>
    </section>
  </div>
</BaseLayout>
