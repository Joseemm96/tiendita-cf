---
import type { StoreSettings } from "@/config/store";

interface Props {
  settings: StoreSettings;
  compact?: boolean;
}

const { settings, compact = false } = Astro.props;
const links = [
  settings.instagramActive && settings.instagramUrl
    ? { label: "Instagram", href: settings.instagramUrl, icon: "instagram" }
    : null,
  settings.facebookActive && settings.facebookUrl
    ? { label: "Facebook", href: settings.facebookUrl, icon: "facebook" }
    : null,
  settings.whatsappActive && settings.whatsappNumber
    ? { label: "WhatsApp", href: `https://wa.me/${settings.whatsappNumber}`, icon: "whatsapp" }
    : null,
].filter((link): link is { label: string; href: string; icon: string } => Boolean(link));
---

{links.length > 0 && (
  <div class:list={["social-links", { "social-links-compact": compact }]} aria-label="Redes sociales">
    {links.map((link) => (
      <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
        {link.icon === "instagram" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4.25" />
            <circle class="social-icon-fill" cx="17.4" cy="6.7" r="1.1" />
          </svg>
        )}
        {link.icon === "facebook" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="social-icon-fill" d="M13.7 21v-8h2.8l.42-3.12H13.7V7.9c0-.9.25-1.52 1.58-1.52H17V3.6c-.3-.04-1.32-.13-2.5-.13-2.47 0-4.17 1.5-4.17 4.28v2.13H7.5V13h2.83v8h3.37Z" />
          </svg>
        )}
        {link.icon === "whatsapp" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.4 11.7a8.4 8.4 0 0 1-12.45 7.36L3.5 20.5l1.45-4.3A8.4 8.4 0 1 1 20.4 11.7Z" />
            <path class="social-icon-fill" d="M9.2 7.5c-.2-.46-.42-.47-.62-.48h-.53c-.18 0-.47.07-.72.34-.25.28-.96.94-.96 2.3 0 1.35.99 2.66 1.12 2.84.14.18 1.94 2.96 4.7 4.15 2.3.98 2.77.79 3.27.74.5-.05 1.62-.66 1.85-1.3.23-.64.23-1.19.16-1.3-.07-.12-.25-.19-.53-.33-.28-.14-1.62-.8-1.87-.89-.25-.09-.43-.14-.62.14-.18.28-.7.89-.87 1.07-.16.18-.32.2-.6.07-.28-.14-1.17-.43-2.23-1.38a8.35 8.35 0 0 1-1.54-1.92c-.16-.28-.02-.43.12-.57.13-.12.28-.32.42-.48.14-.16.18-.28.28-.46.09-.18.04-.34-.03-.48-.07-.14-.61-1.5-.85-2.05Z" />
          </svg>
        )}
        <span class="visually-hidden">{link.label}</span>
      </a>
    ))}
  </div>
)}
